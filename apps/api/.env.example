# =============================================================================
# PRODUCTION (Render) — recommended values
# =============================================================================
# DEBUG=false
# REGISTRATION_AUTO_APPROVE=false
# ALLOW_TUNNEL_CORS=false
# JOB_WORKER_ENABLED=false
# MEMBER_PORTAL_URL=https://your-member.vercel.app
# CORS_ORIGINS=https://your-member.vercel.app,https://your-admin.vercel.app
# JWT_SECRET=<32+ random characters>
# Tests/dev deps: pip install -r requirements-dev.txt
# =============================================================================

# Local dev (no Docker): SQLite
DATABASE_URL=sqlite+aiosqlite:///./osaja_welfare.db

# Redis is optional for local development; the job worker is disabled by default.
REDIS_URL=redis://localhost:6379/0
JOB_WORKER_ENABLED=false

# Email digest (SMTP) — optional
EMAIL_ENABLED=false
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=noreply@osaja.com
# SMTP_USE_TLS=true
JWT_SECRET=local-only-change-before-deploying-this-application
DEBUG=true
REGISTRATION_AUTO_APPROVE=true
RATE_LIMIT_AUTH_PER_MINUTE=10
ALLOW_TUNNEL_CORS=false
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003
USE_LOCAL_AUTH=true

# For a production-like local database, replace DATABASE_URL above with:
# postgresql://postgres:postgres@localhost:5432/osaja_welfare
# and start PostgreSQL with `docker compose -f infrastructure/docker/docker-compose.yml up -d postgres`.

# Production requires a strong JWT_SECRET, DEBUG=false, PostgreSQL, and explicit CORS origins.

# Supabase (production auth)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_KEY=
# SUPABASE_JWT_SECRET=
# Public Storage bucket for profile photos (see docs/deployment/Deployment.md)
SUPABASE_STORAGE_BUCKET=avatars

# Set false to use Supabase Auth when credentials above are filled in
# USE_LOCAL_AUTH=false

# Member portal URL — password-reset redirect + Paystack payment callback
# MEMBER_PORTAL_URL=http://localhost:3000
TICKET_CALLBACK_URL=http://localhost:3002/tickets/complete
# Generate a Fernet key and keep it stable to preserve ticket retrieval:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# TICKET_TOKEN_ENCRYPTION_KEY=

# Paystack (online dues) — https://dashboard.paystack.com/#/settings/developer
# PAYSTACK_SECRET_KEY=sk_test_...
# PAYSTACK_PUBLIC_KEY=pk_test_...
# Webhook URL (production): https://your-api.example.com/api/v1/payments/webhook
# Pass Paystack fees to members at checkout (welfare receives exact dues amount)
# PAYSTACK_PASS_FEES_TO_CUSTOMER=true
# PAYSTACK_FEE_PERCENT=1.95
# PAYSTACK_FEE_CAP_GHS=   # optional; leave blank for Ghana percentage-only pricing

# Comma-separated browser origins (required when DEBUG=false)
# CORS_ORIGINS=https://your-member.vercel.app,https://your-admin.vercel.app
# ALLOW_TUNNEL_CORS=false in production (when true, ANY *.trycloudflare.com origin is allowed)
# ALLOW_TUNNEL_CORS=true

# Web Push (VAPID) — npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_CONTACT_EMAIL=admin@osaja.com

# Portal contact — copy to NEXT_PUBLIC_WHATSAPP_NUMBER in each web app .env.local
# WHATSAPP_NUMBER=233531275098/233532917832

# Arkesel SMS (SMS Portal) — use approved Sender ID exactly as registered
# ARKESEL_API_KEY=
# ARKESEL_SENDER_ID=OSAJA20
# ARKESEL_BASE_URL=https://sms.arkesel.com/api/v2
# ARKESEL_SANDBOX=false
# PUBLIC_API_URL=https://your-api.example.com
